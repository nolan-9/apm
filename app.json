{
  "expo": {
    "scheme": "FINazon",
    "name": "FINazon",
    "slug": "FINazon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.nolanfl.finazon",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-asset",
      [
        "expo-router",
        {
          "root": "src/app"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "router": {
        "root": "src/app",
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "99bf86db-9f5b-412e-926d-5decf04c05fd"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/99bf86db-9f5b-412e-926d-5decf04c05fd"
    }
  }
}
