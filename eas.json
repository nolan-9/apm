{
  "cli": {
    "version": ">= 27.11.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_MODE": "aws",
        "EXPO_PUBLIC_API_URL_AWS": "https://13-184-245-28.sslip.io/api"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_APP_MODE": "aws",
        "EXPO_PUBLIC_API_URL_AWS": "https://13-184-245-28.sslip.io/api"
      }
    }
  },
  "submit": {
    "production": {}
  }
}